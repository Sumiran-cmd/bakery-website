# ==============================================================================
# Bean Theory — Environment Configuration Example
# Copy this file to .env and fill in real values.
# NEVER commit .env (with real values) to version control.
# ==============================================================================

# ---------------------------------------------------------------------------
# Flask server
# ---------------------------------------------------------------------------
FLASK_APP=run.py
# 'development' | 'production' | 'testing'
FLASK_ENV=development
# Enable Flask debug server ONLY in development — never in production
FLASK_DEBUG=false

# Generate strong random values for production:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-secret-key-bean-theory-change-in-production

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Default: local SQLite (development only)
DATABASE_URL=sqlite:///bean_theory.db
# Production MySQL example:
# DATABASE_URL=mysql+pymysql://beantheory_user:STRONG_PASSWORD@db-host:3306/bean_theory

# ---------------------------------------------------------------------------
# JWT Authentication
# ---------------------------------------------------------------------------
JWT_SECRET_KEY=dev-jwt-secret-bean-theory-change-in-production
JWT_ACCESS_TOKEN_EXPIRES=86400          # 24 hours in seconds
JWT_REMEMBER_TOKEN_EXPIRES=2592000      # 30 days in seconds
# Must be 'true' in production (requires HTTPS)
JWT_COOKIE_SECURE=false
JWT_COOKIE_SAMESITE=Lax

# ---------------------------------------------------------------------------
# CORS / Frontend
# ---------------------------------------------------------------------------
FRONTEND_URL=http://localhost:5173
# Production example: FRONTEND_URL=https://beantheory.com.np

# ---------------------------------------------------------------------------
# Email (SMTP — for password reset)
# If left blank, the development adapter logs the reset link to stdout.
# ---------------------------------------------------------------------------
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=no-reply@beantheory.com.np

# ---------------------------------------------------------------------------
# Security & Rate Limiting
# ---------------------------------------------------------------------------
AUTH_RATE_LIMIT_MAX_ATTEMPTS=10         # Max failed login attempts per window
AUTH_RATE_LIMIT_WINDOW_SECONDS=900      # 15-minute sliding window
PASSWORD_RESET_TOKEN_EXPIRATION_HOURS=1 # Reset link validity in hours

# ---------------------------------------------------------------------------
# Production port (used by run.py)
# ---------------------------------------------------------------------------
PORT=5000
